# --- GitHub (watcher.py, docs_gen.py, publisher.py, main.py) ---
GITHUB_TOKEN=ghp_your_token_here
# Optional: default repository when none is passed on the command line.
# GITHUB_REPO=owner/name

# --- LLM (docs_gen.py, publisher.py, main.py) - any OpenAI-compatible endpoint ---
LLM_API_KEY=sk-your_key_here
# LLM_MODEL=gemini
# Point at Groq, Together, OpenRouter, Ollama, etc. if not using api.openai.com:
# LLM_BASE_URL=https://api.openai.com/v1
